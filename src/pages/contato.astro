---
import Inner from '../layouts/Inner.astro'
import { institution } from '../data/site'
import { url } from '../utils/urls'
---
<Inner title="Contato" summary="Fale com a equipe sobre seleção, projetos acadêmicos e parcerias.">
  <div class="phase-grid">
    <section><h2>Fale com o LABEM</h2><ul class="source-links"><li><a class="text-link" href={`mailto:${institution.email}`}>{institution.email}</a></li><li><a class="text-link" href={institution.instagram}>Instagram · @labemufcg</a></li><li><a class="text-link" href={institution.linkedin}>LinkedIn</a></li></ul></section>
    <section><h2>Onde estamos</h2><p>Centro de Ciências e Tecnologia<br />Universidade Federal de Campina Grande</p><address>{institution.location}</address><a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Universidade+Federal+de+Campina+Grande+Bodocongo">Abrir no mapa</a></section>
  </div>
  <div class="actions list-actions"><a class="button" href={url('faca-parte/')}>Informações para estudantes</a><a class="button dark-outline" href={url('parceiros/')}>Informações para empresas</a></div>
</Inner>
