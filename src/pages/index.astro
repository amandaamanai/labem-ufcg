---
import Base from '../layouts/Base.astro'
import Banner from '../components/Banner.astro'
import Timeline from '../components/Timeline.astro'
import Photo from '../components/Photo.astro'
import Gallery from '../components/Gallery.astro'
import OpportunityList from '../components/OpportunityList.astro'
import { engineering, homeGallery, homeSections, instagramBanner, partners, photos } from '../data/site'
import { url } from '../utils/urls'
---
<Base>
  <Banner />
  {homeSections.map(section => {
    switch (section) {
      case 'sobre': return (
        <section class="wrap split section-pad" id="sobre">
          <div class="split-copy">
            <p class="eyebrow red-mark">Fundado em 2012 · Campina Grande, PB</p>
            <h2>DA BANCADA<br />À PISTA<span class="accent">.</span></h2>
            <p>O Laboratório de Engenharia da Motocicleta é um projeto da UFCG. Estudantes de diferentes áreas projetam, fabricam e testam motocicletas de motovelocidade.</p>
            <a href={url('sobre/')} class="text-link">Conheça o laboratório</a>
          </div>
          <figure class="feature-photo"><Photo photo={photos.team} /><figcaption>Equipe Galo de Campina · UFCG</figcaption></figure>
        </section>
      )
      case 'historia': return (
        <section class="history-band" id="historia">
          <div class="wrap split section-pad">
            <div class="split-copy"><p class="eyebrow red-mark">Nossa história</p><h2>DE CAMPINA<br />A ARAGÓN<span class="accent">.</span></h2><p>Da criação na Engenharia Mecânica à apresentação do projeto na fase teórica da MotoStudent, conheça os marcos da equipe.</p><a class="text-link" href={url('sobre/#historia')}>Leia a trajetória do LABEM</a></div>
            <Timeline />
          </div>
        </section>
      )
      case 'competicao': return (
        <section class="project-band" id="competicao">
          <div class="wrap split section-pad">
            <figure class="project-photo"><Photo photo={photos.prototype} /></figure>
            <div class="split-copy"><p class="eyebrow red-mark">Competição internacional</p><h2>MOTOSTUDENT<span class="accent">.</span></h2>
              <p>A MotoStudent desafia estudantes a desenvolver uma motocicleta de corrida. Em 2018, o LABEM participou da fase teórica em Aragón, com a apresentação do projeto.</p>
              <div class="actions"><a class="button" href={url('motostudent/')}>Sobre a competição</a><a class="button outline" href={url('projetos/prototipo-de-motovelocidade/')}>Ver protótipo</a></div>
            </div>
          </div>
        </section>
      )
      case 'engenharia': return (
        <section class="wrap split section-pad engineering-home" id="engenharia">
          <div class="split-copy"><p class="eyebrow red-mark">Projetos e engenharia</p><h2>SEIS FRENTES.<br />UMA MOTO<span class="accent">.</span></h2><p>Do chassi ao trabalho com a comunidade, cada frente contribui para o desenvolvimento do projeto.</p><div class="actions"><a class="button" href={url('projetos/')}>Conheça os projetos</a><a class="text-link" href={url('pesquisa/')}>Produção científica</a></div></div>
          <ul class="department-list">{engineering.map(item => <li><a href={url(`engenharia/${item.slug}/`)}>{item.title}<span aria-hidden="true">+</span></a></li>)}</ul>
        </section>
      )
      case 'galeria': return (
        <section class="photo-band" id="galeria">
          <div class="wrap section-pad">
            <div class="section-heading"><div><p class="eyebrow red-mark">Galeria</p><h2>O LABEM EM IMAGENS<span class="accent">.</span></h2></div><a class="text-link" href={url('galeria/')}>Ver todos os álbuns</a></div>
            <Gallery photos={homeGallery} />
          </div>
        </section>
      )
      case 'oportunidades': return (
        <section class="wrap split section-pad" id="oportunidades">
          <div class="split-copy"><p class="eyebrow red-mark">Eventos e recrutamento</p><h2>OPORTUNIDADES<span class="accent">.</span></h2><p>Consulte as próximas atividades do laboratório e os processos seletivos da equipe.</p><a class="text-link" href={url('oportunidades/')}>Central de oportunidades</a></div>
          <div><OpportunityList home /></div>
        </section>
      )
      case 'instagram': return (
        <section class="social-band" id="instagram">
          <a class="wrap social-banner" href={instagramBanner.href}>
            <div class="social-copy"><p class="eyebrow red-mark">Instagram · @labemufcg</p><h2>{instagramBanner.title}</h2><p>{instagramBanner.description}</p><span class="button">{instagramBanner.button}</span></div>
            <div class="social-photos" aria-hidden="true">{instagramBanner.photos.map(photo => <Photo photo={photo} />)}</div>
          </a>
        </section>
      )
      case 'parceiros': return (
        <section class="wrap section-pad" id="parceiros">
          <div class="section-heading"><div><p class="eyebrow red-mark">Vínculos institucionais</p><h2>PARCEIROS<span class="accent">.</span></h2></div><a class="text-link" href={url('parceiros/')}>Conheça nossas parcerias</a></div>
          <ul class="institutional-partners">{partners.map(partner => <li>{partner.logo && <img src={url(partner.logo)} alt="" loading="lazy" />}{partner.href ? <a href={partner.href}>{partner.name}</a> : <span>{partner.name}</span>}</li>)}</ul>
        </section>
      )
      case 'apoio': return (
        <section class="join-band" id="participe"><div class="wrap section-pad split-copy">
          <p class="eyebrow red-mark">Empresas e instituições</p><h2>APOIE O LABEM<span class="accent">.</span></h2>
          <p>Contribua para a formação de estudantes e para o desenvolvimento dos próximos protótipos.</p>
          <a class="button" href={url('parceiros/')}>Seja nosso parceiro</a>
        </div></section>
      )
    }
  })}
</Base>
