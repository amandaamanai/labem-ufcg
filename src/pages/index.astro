---
import Base from '../layouts/Base.astro'
import Banner from '../components/Banner.astro'
import Timeline from '../components/Timeline.astro'
import ImageSlot from '../components/ImageSlot.astro'
import SubsystemCards from '../components/SubsystemCards.astro'
import { homeSections, instagramBanner, partners, trajectory } from '../data/site'
import { imageMap, imageSlots } from '../data/imageSlots'
import { availablePhoto } from '../utils/images'
import { getEvent } from '../data/events'
import { recruitment, recruitmentStatus } from '../data/recruitment'
import { url } from '../utils/urls'

const event = getEvent()
const showEvent = event?.active && event.featured
const showSelection = recruitment.status !== 'sem-edital' && recruitment.featured
const socialSlots = instagramBanner.slots.map(id => imageSlots[id]).filter(slot => imageMap || availablePhoto(slot.photo) || availablePhoto(slot.mobile))
const openLogoSlots = Object.keys(imageSlots).filter(id => id.startsWith('PARTNER-LOGO-') && !partners.some(partner => partner.logoSlot === id))
---
<Base>
  <Banner />
  {homeSections.map(section => {
    switch (section) {
      case 'parceiros': return (
        <section class="partner-band" id="parceiros">
          <div class="wrap partner-band-inner">
            <div class="partner-band-heading"><h2>Quem acredita no nosso projeto</h2><p>Parcerias que impulsionam a pesquisa, a inovação e a formação de futuros profissionais.</p></div>
            <ul class="partner-strip">
              {partners.map(partner => {
                const logo = availablePhoto(partner.logo ? { file: partner.logo, alt: partner.name } : undefined)
                const frame = partner.logoSlot ? imageSlots[partner.logoSlot] : undefined
                const content = <>{(logo || frame) && <ImageSlot media={{ ...frame, id: frame?.id ?? partner.name, label: frame?.label ?? partner.name, photo: logo && { ...logo, alt: '' }, ratio: '3 / 2', fit: 'contain' }} />}<span>{partner.name}</span><small>{partner.category}</small></>
                return <li>{partner.href ? <a class="partner-tile" href={partner.href}>{content}</a> : <div class="partner-tile">{content}</div>}</li>
              })}
              {imageMap && openLogoSlots.map(id => <li class="partner-tile"><ImageSlot media={imageSlots[id]} /></li>)}
            </ul>
            <a class="button dark-outline" href={url('parceiros/')}>Conheça nossos parceiros</a>
          </div>
        </section>
      )
      case 'historia': return (
        <section class="wrap section-pad history-editorial" id="historia">
          <div class="editorial-intro">
            <p class="eyebrow red-mark">{trajectory.eyebrow}</p>
            <h2>{trajectory.title}</h2>
            <p>{trajectory.description}</p>
            <a class="text-link" href={url('sobre/#historia')}>Conheça nossa história</a>
          </div>
          <Timeline />
        </section>
      )
      case 'competicao': return (
        <section class="project-band" id="competicao">
          <div class="wrap split section-pad">
            <ImageSlot media={imageSlots['MOTOSTUDENT-HOME']} />
            <div class="split-copy"><p class="eyebrow red-mark">Competição internacional</p><h2>MOTOSTUDENT<span class="accent">.</span></h2>
              <p>A MotoStudent é uma competição internacional que desafia estudantes universitários a aplicar seus conhecimentos no desenvolvimento de motocicletas de competição.</p>
              <p>Por meio da equipe Galo de Campina, o LABEM conecta a formação acadêmica aos desafios reais da engenharia motociclística, integrando projeto, fabricação, pesquisa e desenvolvimento tecnológico.</p>
              <div class="actions"><a class="button" href={url('motostudent/')}>Sobre a competição</a><a class="button outline" href={url('projetos/prototipo-de-motovelocidade/')}>Ver protótipo</a></div>
            </div>
          </div>
        </section>
      )
      case 'engenharia': return (
        <section class="wrap section-pad engineering-home" id="engenharia">
          <div class="editorial-intro">
            <p class="eyebrow red-mark">Subsistemas</p>
            <h2>Diferentes competências. Um propósito.</h2>
            <p>Das atividades de fabricação na oficina mecânica da universidade ao desenvolvimento de projetos, pesquisas e ações institucionais, nossos subsistemas integram diferentes conhecimentos e competências para transformar a formação acadêmica em experiência prática.</p>
          </div>
          <SubsystemCards />
          <div class="actions"><a class="button" href={url('projetos/')}>Conheça os projetos</a><a class="text-link" href={url('pesquisa/')}>Produção científica</a></div>
        </section>
      )
      case 'oportunidades': return (
        <section class="wrap section-pad opportunity-section" id="oportunidades">
          <div class="opportunity-panel">
            <div><p class="eyebrow red-mark">Faça parte da equipe!</p><h2>Seu próximo desafio começa aqui.</h2><p>Amplie seus conhecimentos, participe de experiências acadêmicas e desenvolva novas habilidades junto ao LABEM.</p></div>
            <div class="opportunity-actions">
              <div>{showSelection && <p>{recruitmentStatus} · {recruitment.edition ?? recruitment.title}</p>}<a class="button" href={url('faca-parte/')}>Processo seletivo</a></div>
              <div>{showEvent && <p>{event.title}</p>}<a class="button dark-outline" href={url('eventos/')}>Eventos e inscrições</a></div>
            </div>
          </div>
        </section>
      )
      case 'instagram': return (
        <section class="social-band" id="instagram">
          <a class:list={['wrap', 'social-banner', { 'social-banner-with-photos': socialSlots.length }]} href={instagramBanner.href}>
            <div class="social-copy"><p class="eyebrow red-mark">Instagram · @labemufcg</p><h2>{instagramBanner.title}</h2><p>{instagramBanner.description}</p><span class="button">{instagramBanner.button}</span></div>
            {!!socialSlots.length && <div class="social-photos">{socialSlots.map(slot => <ImageSlot media={slot} />)}</div>}
          </a>
        </section>
      )
      case 'apoio': return (
        <section class="wrap section-pad" id="participe">
          <div class="partner-cta">
            <div><p class="eyebrow red-mark">Empresas e instituições</p><h2>Construa o futuro da engenharia com a gente.</h2><p>Apoie a formação de futuros profissionais, incentive a pesquisa aplicada e contribua para o desenvolvimento de novas tecnologias por meio da parceria entre universidade e indústria.</p></div>
            <a class="button" href={url('parceiros/')}>Seja nosso parceiro</a>
          </div>
        </section>
      )
    }
  })}
</Base>
