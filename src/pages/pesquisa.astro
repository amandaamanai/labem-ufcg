---
import Inner from '../layouts/Inner.astro'
import Collection from '../components/Collection.astro'
import { publications } from '../data/site'
import { url } from '../utils/urls'
const filters = [
  { key: 'year', label: 'Ano', options: [...new Set(publications.map(item => item.year))] },
  { key: 'category', label: 'Categoria', options: [...new Set(publications.map(item => item.category))] },
]
---
<Inner title="Produção científica" summary="Estudos sobre projeto, fabricação e validação de motocicletas e seus componentes.">
  <section class="content-section"><h2>Publicações</h2><Collection fields={filters}><ul class="records">{publications.map(item => <li data-year={item.year} data-category={item.category}><p class="eyebrow">{item.year} · {item.category} · {item.venue}</p><h3>{item.title}</h3><p>{item.authors}</p><p>{item.summary}</p><a class="text-link" href={'https://doi.org/' + item.doi}>Ler nos anais · DOI {item.doi}</a></li>)}</ul></Collection></section>
  <section class="prose-block"><h2>Pesquisa aplicada</h2><p>Uma das linhas de inovação estuda como recuperar parte da energia dissipada pela suspensão de um veículo.</p><a class="text-link" href={url('projetos/recuperacao-de-energia/')}>Conheça o estudo do amortecedor</a></section>
</Inner>
