---
import Inner from '../layouts/Inner.astro'
import GoogleForm from '../components/GoogleForm.astro'
import CopyLink from '../components/CopyLink.astro'
import { recruitment as selection, recruitmentStatus } from '../data/recruitment'
import { engineering, institution, photos, sources } from '../data/site'
import { formLinks, publicHref } from '../utils/opportunities'
import { url } from '../utils/urls'
const active = selection.status !== 'sem-edital'
const canRegister = selection.status === 'inscricoes-abertas' && !!formLinks(selection.form).external
const showResults = selection.status === 'resultado' && !!selection.results?.length
const edition = [selection.edition, selection.year].filter(Boolean).join(' · ')
---
<Inner imageGroup="PROCESSO-SELETIVO" title={selection.title} summary={selection.description} photo={selection.banner ?? photos.team} mobilePhoto={selection.mobileBanner} sharing={active ? selection.sharing : undefined}>
  <section class="content-section recruitment-intro">
    <p class="eyebrow red-mark">Processo seletivo{active && edition && ` · ${edition}`}</p>
    <h2>{recruitmentStatus}</h2>
    {!active && <p>Os próximos editais serão divulgados no Instagram do LABEM.</p>}
    <div class="actions list-actions">
      {canRegister && <a class="button" href="#inscricoes">Fazer inscrição</a>}
      {showResults && <a class="button" href="#resultados">Ver resultados</a>}
      {active && selection.noticePdf && <a class="button dark-outline" href={publicHref(selection.noticePdf)}>Ler edital (PDF)</a>}
      {!canRegister && <a class="button dark-outline" href={institution.instagram}>Acompanhar no Instagram</a>}
      <CopyLink href={active ? selection.sharing?.url : undefined} />
    </div>
  </section>

  {active && <>
    {!!selection.requirements?.length && <section class="content-section"><h2>Requisitos</h2><ul>{selection.requirements.map(requirement => <li>{requirement}</li>)}</ul></section>}
    {!!selection.positions?.length && <section class="content-section"><h2>Vagas e áreas</h2><ul class="records">{selection.positions.map(position => <li><h3>{position.area}</h3>{position.count !== undefined && <p>{position.count} {position.count === 1 ? 'vaga' : 'vagas'}</p>}{position.description && <p>{position.description}</p>}</li>)}</ul></section>}
    {!!selection.schedule?.length && <section class="content-section"><h2>Cronograma</h2><ul class="records">{selection.schedule.map(item => <li><p class="eyebrow">{item.date}</p><h3>{item.label}</h3></li>)}</ul></section>}
    {!!selection.stages?.length && <section class="content-section"><h2>Etapas</h2><ol class="phase-list">{selection.stages.map(stage => <li>{stage}</li>)}</ol></section>}
    {showResults && <section id="resultados" class="content-section"><h2>Resultados</h2><ul class="source-links">{selection.results?.map(result => <li><a class="text-link" href={publicHref(result.href)}>{result.label}</a></li>)}</ul></section>}
    {!!selection.documents?.length && <section class="content-section"><h2>Documentos complementares</h2><ul class="source-links">{selection.documents.map(document => <li><a class="text-link" href={publicHref(document.href)}>{document.label}</a></li>)}</ul></section>}
    {canRegister && <GoogleForm form={selection.form} title={selection.title} />}
  </>}

  <section class="content-section"><h2>Por que participar</h2><p>Trabalhe em um projeto real, colabore com estudantes de diferentes áreas e acompanhe o caminho da pesquisa e da fabricação até os testes.</p><ul class="department-list">{engineering.map(item => <li><a href={url(`engenharia/${item.slug}/`)}>{item.title}<span aria-hidden="true">+</span></a></li>)}</ul></section>
  {!!selection.faq.length && <section class="content-section faq"><h2>Perguntas frequentes</h2>{selection.faq.map(item => <details><summary>{item.question}</summary><p>{item.answer}</p></details>)}</section>}
  <section class="content-section"><h2>Editais anteriores</h2><p>Seleção 2022.2, divulgada pelo CCT em 2023.</p><a class="text-link" href={sources.recruitment}>Acessar publicação do CCT/UFCG</a></section>
</Inner>
