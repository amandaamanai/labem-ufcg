---
import Detail from '../../layouts/Detail.astro'
import { engineering } from '../../data/site'
export function getStaticPaths() {
  return engineering.map(entry => ({ params: { slug: entry.slug }, props: { entry } }))
}
const { entry } = Astro.props
---
<Detail {entry} entries={engineering} base="engenharia" label="Engenharia"  />
