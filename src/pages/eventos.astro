---
import Inner from '../layouts/Inner.astro'
import Photo from '../components/Photo.astro'
import GoogleForm from '../components/GoogleForm.astro'
import CopyLink from '../components/CopyLink.astro'
import { getEvent } from '../data/events'
import { institution, photos } from '../data/site'
import { formatEventDate, formLinks, timestamp } from '../utils/opportunities'
import { url } from '../utils/urls'
const configured = getEvent()
const event = configured?.active ? configured : null
const labels = { 'em-breve': 'Inscrições em breve', aberta: 'Inscrições abertas', encerrada: 'Inscrições encerradas', 'sem-inscricao': 'Evento sem inscrição' }
const canRegister = event?.registration === 'aberta' && !!formLinks(event.form).external
const calendar = event?.calendar && event.endsAt && timestamp(event.startsAt) < timestamp(event.endsAt)
---
<Inner imageGroup="EVENTO" title={event?.title ?? 'Eventos do LABEM'} summary={event?.subtitle ?? (event ? event.description : 'Acompanhe os próximos encontros, palestras e atividades de extensão do laboratório.')} photo={event?.banner ?? photos.class} mobilePhoto={event?.mobileBanner} sharing={event?.sharing}>
  {event ? (
    <>
      <section class="content-section event-intro">
        <p class="eyebrow red-mark">{labels[event.registration]}</p>
        <h2>Sobre o evento</h2>
        <p>{event.description}</p>
        <dl class="event-facts">
          <div><dt>Data e horário</dt><dd><time datetime={event.startsAt}>{formatEventDate(event.startsAt, event.timeZone)}</time>{event.endsAt && <> até <time datetime={event.endsAt}>{formatEventDate(event.endsAt, event.timeZone)}</time></>} · {event.timeZone}</dd></div>
          <div><dt>Modalidade</dt><dd>{event.format}</dd></div>
          <div><dt>Local</dt><dd>{event.location}</dd></div>
          {event.audience && <div><dt>Público-alvo</dt><dd>{event.audience}</dd></div>}
          {event.certificate && <div><dt>Certificado</dt><dd>{event.certificate}</dd></div>}
        </dl>
        {event.countdown && <p class="countdown" data-countdown={event.startsAt} hidden></p>}
        <div class="actions list-actions">
          {canRegister && <a class="button" href="#inscricoes">Fazer inscrição</a>}
          {calendar && <a class="button dark-outline" href={url('eventos/agenda.ics')} download>Adicionar à agenda</a>}
          <CopyLink href={event.sharing?.url} />
        </div>
      </section>
      {!!event.speakers?.length && <section class="content-section"><h2>Palestrantes</h2><ul class="records">{event.speakers.map(speaker => <li class="speaker">{speaker.photo && <Photo photo={speaker.photo} />}<div><h3>{speaker.name}</h3><p>{speaker.bio}</p></div></li>)}</ul></section>}
      {!!event.schedule?.length && <section class="content-section"><h2>Programação</h2><ul class="records">{event.schedule.map(item => <li><p class="eyebrow">{item.time}</p><h3>{item.title}</h3>{item.description && <p>{item.description}</p>}</li>)}</ul></section>}
      {canRegister && <GoogleForm form={event.form} title={event.title} />}
    </>
  ) : (
    <section class="prose-block"><h2>Próximos eventos</h2><p>O LABEM divulga novas datas e inscrições no Instagram.</p><div class="actions"><a class="button" href={institution.instagram}>Acompanhar no Instagram</a><CopyLink /></div></section>
  )}
</Inner>
