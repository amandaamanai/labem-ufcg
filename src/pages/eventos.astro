---
import Inner from '../layouts/Inner.astro'
import EntryCard from '../components/EntryCard.astro'
import { institution, news, upcomingEvents } from '../data/site'
const dateFormat = new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeStyle: 'short', timeZone: 'America/Sao_Paulo' })
---
<Inner title="Eventos" summary="Agenda do laboratório e registros de feiras, congressos e atividades de extensão.">
  <section class="content-section"><h2>Próximos eventos</h2>
    {upcomingEvents.length ? <ul class="records">{upcomingEvents.map(event => <li><p class="eyebrow">{event.status}</p><h3>{event.title}</h3><p><time datetime={event.date}>{dateFormat.format(new Date(event.date))}</time> · {event.place}</p><p>{event.description}</p>{event.countdown && <p data-countdown={event.date} hidden></p>}{event.href && <a class="text-link" href={event.href}>Mais informações</a>}</li>)}</ul> : <p>Acompanhe o Instagram do LABEM para saber quando houver novas datas.</p>}
    <a class="text-link" href={institution.instagram}>Instagram · @labemufcg</a>
  </section>
  <section class="content-section"><h2>Eventos anteriores</h2><div class="cards">{news.filter(item => ['Eventos', 'Competições', 'Workshops'].includes(item.category)).map(entry => <EntryCard {entry} base="noticias" />)}</div></section>
</Inner>
