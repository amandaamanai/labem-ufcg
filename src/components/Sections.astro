---
import type { Section } from '../data/site'
const { sections, heading = 'h2' } = Astro.props as { sections: Section[]; heading?: 'h2' | 'h3' }
const Heading = heading
---
{sections.map(section => <section id={section.id} class="prose-block">
  <Heading>{section.title}</Heading><p>{section.text}</p>
  {section.items && <ul>{section.items.map(item => <li>{item}</li>)}</ul>}
  {section.links && <ul class="source-links">{section.links.map(link => <li><a class="text-link" href={link.href}>{link.label}</a></li>)}</ul>}
</section>)}
