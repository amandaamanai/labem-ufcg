---
import { timeline } from '../data/site'
import { imageSlots } from '../data/imageSlots'
import ImageSlot from './ImageSlot.astro'
---
<ol class="timeline">
  {timeline.map(item => <li class:list={['timeline-step', { 'timeline-future': !item.year }]}>
    <article class="timeline-card">
      {item.year && <span class="timeline-year">{item.year}</span>}
      <h3>{item.title}</h3>
      <p>{item.text}</p>
      {item.slot && <ImageSlot media={imageSlots[item.slot]} />}
      {item.source && <a class="text-link" href={item.source.href}>{item.source.label}</a>}
    </article>
  </li>)}
</ol>
