---
import InstitutionalIcon from './InstitutionalIcon.astro'
import Photo from './Photo.astro'
import type { Publication } from '../data/site'
import { availablePhoto } from '../utils/images'
import { url } from '../utils/urls'

const { publication } = Astro.props as { publication: Publication }
const publisher = publication.officialUrl ?? (publication.doi && 'https://doi.org/' + publication.doi)
const document = publication.document && url(publication.document)
const photo = availablePhoto(publication.photo)
---
<article class="publication-card">
  <span class="institutional-icon"><InstitutionalIcon name="document" /></span>
  <div class="publication-copy">
    <p class="eyebrow">{publication.category} · {publication.year}</p>
    <h3>{publication.title}</h3>
    <p>{publication.authors}</p>
    {publication.venue && <p>{publication.venue}</p>}
    <p>{publication.summary}</p>
    {publication.doi && <p class="publication-doi">DOI {publication.doi}</p>}
    {photo && <Photo {photo} class="publication-photo" />}
    {(publisher || document) && <div class="publication-links">
      {publisher && <a class="text-link" href={publisher}>Acessar publicação</a>}
      {document && <a class="text-link" href={document} download>Baixar documento</a>}
    </div>}
  </div>
</article>
<style>
  .publication-card {
    display: flex;
    align-items: flex-start;
    gap: clamp(12px, 2vw, 22px);
    border: 1px solid var(--inst-line);
    border-radius: 20px;
    background: var(--inst-surface);
    padding: clamp(16px, 2vw, 26px);
  }
  .publication-card .institutional-icon { width: 42px; height: 42px; }
  .publication-copy { min-width: 0; }
  .publication-copy .eyebrow { margin-bottom: 7px; color: var(--muted); }
  .publication-copy h3 { margin: 0 0 9px; }
  .publication-copy p { margin: 0 0 6px; color: var(--muted); }
  .publication-doi { overflow-wrap: anywhere; font-size: .87rem; }
  .publication-links { display: flex; flex-wrap: wrap; gap: 10px 18px; margin-top: 12px; }
  .publication-photo { max-width: min(100%, 360px); margin-top: 12px; border-radius: 14px; }
  @media (max-width: 420px) {
    .publication-card .institutional-icon { width: 32px; height: 32px; }
    .publication-card .institutional-icon svg { width: 22px; height: 22px; }
  }
</style>
