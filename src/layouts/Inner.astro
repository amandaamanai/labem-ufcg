---
import Base from './Base.astro'
import Photo from '../components/Photo.astro'
import type { Photo as PhotoData } from '../data/site'
import type { Sharing } from '../utils/opportunities'
import { url } from '../utils/urls'
const { title, summary, photo, mobilePhoto, sharing, parent, noindex = false } = Astro.props as { title: string; summary: string; photo?: PhotoData; mobilePhoto?: PhotoData; sharing?: Sharing; parent?: { href: string; label: string }; noindex?: boolean }
---
<Base title={title} description={summary} image={photo?.file} noindex={noindex} {sharing}>
  <section class:list={['inner-hero', { 'inner-with-photo': photo }]}>
    {photo && <picture>{mobilePhoto && <source media="(max-width: 650px)" srcset={url('images/' + mobilePhoto.file)} />}<Photo photo={photo} eager /></picture>}
    <div class="wrap inner-hero-content">
      <nav class="breadcrumb" aria-label="Localização"><a href={url()}>Início</a>{parent && <><span aria-hidden="true"> / </span><a href={url(parent.href)}>{parent.label}</a></>}</nav>
      <h1>{title}</h1><p>{summary}</p>
    </div>
  </section>
  <div class="wrap inner-body"><slot /></div>
</Base>
