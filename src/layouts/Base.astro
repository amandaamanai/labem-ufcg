---
import '../styles/site.css'
import { institution, navigation, quickLinks } from '../data/site'
import { url } from '../utils/urls'
const { title, description, image = 'banner.webp', noindex = false } = Astro.props as { title?: string; description?: string; image?: string; noindex?: boolean }
const fullTitle = title ? `${title} | LABEM UFCG` : 'LABEM UFCG | Laboratório de Engenharia da Motocicleta'
const summary = description ?? 'Laboratório de Engenharia da Motocicleta da UFCG. Engenharia, pesquisa e protótipos de competição da equipe Galo de Campina.'
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site)
const cover = Astro.site ? new URL(url('images/' + image), Astro.site) : url('images/' + image)
const current = (href: string) => Astro.url.pathname === url(href)
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={summary} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:image" content={cover.toString()} />
    {canonical && <link rel="canonical" href={canonical.toString()} />}
    {canonical && <meta property="og:url" content={canonical.toString()} />}
    <meta name="theme-color" content="#101011" />
    <link rel="icon" href={url('favicon.png')} type="image/png" />
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip" href="#conteudo">Ir para o conteúdo</a>
    <header class="site-header">
      <div class="wrap header-row">
        <a class="brand" href={url()} aria-label="LABEM UFCG, início"><img src={url('images/labem.png')} width="109" height="54" alt="LABEM UFCG MotoStudent Team" /></a>
        <button type="button" class="menu-toggle" aria-expanded="false" aria-controls="site-navigation" hidden>Menu <span aria-hidden="true"></span></button>
        <nav id="site-navigation" aria-label="Navegação principal">
          <ul class="nav-list">
            {navigation.map(({ label, href, children }) => (
              <li class:list={['nav-item', { active: current(href) }]}>
                <a href={url(href)} aria-current={current(href) ? 'page' : undefined}>{label}</a>
                {children && <details class="submenu"><summary aria-label={`Submenu de ${label}`}><span aria-hidden="true"></span></summary><ul>{children.map(child => <li><a href={url(child.href)}>{child.label}</a></li>)}</ul></details>}
              </li>
            ))}
          </ul>
          <a class="button small" href={url('faca-parte/')}>Faça parte</a>
        </nav>
      </div>
    </header>
    <main id="conteudo"><slot /></main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div><a href={url()}><img src={url('images/labem.png')} width="128" height="64" alt="LABEM UFCG MotoStudent Team" /></a><p>{institution.name}<br />Universidade Federal de Campina Grande</p></div>
          <div><p class="footer-label">Explore</p><ul>{quickLinks.map(link => <li><a href={url(link.href)}>{link.label}</a></li>)}</ul></div>
          <div><p class="footer-label">Fale com o LABEM</p><ul>
            <li><a href={`mailto:${institution.email}`}>{institution.email}</a></li>
            <li><a href={institution.instagram}>Instagram · @labemufcg</a></li>
            <li><a href={institution.linkedin}>LinkedIn</a></li>
          </ul><p>Campina Grande, Paraíba</p></div>
        </div>
        <div class="footer-bottom"><span>© <span data-current-year>{new Date().getFullYear()}</span> LABEM UFCG</span><span>Centro de Ciências e Tecnologia · UFCG</span></div>
      </div>
    </footer>
    <script>
      import '../ui'
    </script>
  </body>
</html>
